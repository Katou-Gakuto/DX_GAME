{
    "Function Template cpp": {
        "prefix": "@func_c",
        "body": [
            "// ${1:コメント}",
			"${2:型} ${3:クラス名}::${4:関数名}(${5:引数})",
			"{",
			"}",
        ],
        "description": "関数テンプレート cpp"
    },
    "Function Template h": {
        "prefix": "@func_h",
        "body": [
			"${1:型} ${2:関数名}(${3:引数})${4:};",
        ],
        "description": "関数テンプレート h"
    },
	"Struct Template": {
		"prefix": "@stru",
		"body": [
			"// ${1:コメント}",
			"struct ${2:構造体名}",
			"{",
			"${3:}",
			"};"
		],
		"description": "構造体テンプレート"
	},
	"Enum class Template": {
		"prefix": "@enum",
		"body": [
			"// ${1:コメント}",
			"enum class ${2:列挙型名}",
			"{",
			"${3:}",
			"};"
		],
		"description": "列挙型テンプレート"
	},
	"Class Template": {
		"prefix": "@class",
		"body": [
			"class ${1:クラス名}",
			"{",
			"private:",
			"public:",
			"    ${1:クラス名}();",
			"    ~${1:クラス名}();",
			"};"
		],
		"description": "クラステンプレート"
	},
	"Derived Class Template": {
		"prefix": "@class_d",
		"body": [
			"class ${1:クラス名} : public ${2:基底クラス名}",
			"{",
			"private:",
			"public:",
			"    ${1:クラス名}();",
			"    ~${1:クラス名}();",
			"};"
		],
		"description": "派生クラステンプレート"
	},
	"Class cpp Template": {
		"prefix": "@class_c",
		"body": [
			"#include \"${1:クラス名}.h\"",
			"",
			"",
			"${1:クラス名}::${1:クラス名}()",
			"{",
			"}",
			"${1:クラス名}::~${1:クラス名}()",
			"{",
			"}"
		],
		"description": "クラステンプレート(CPP)"
	},
	"Comment_1": {
		"prefix": "@comm1",
		"body": [
			"/*--${1/(.)/--/g}--*/",
			"/*【${1:コメント}】*/",
			"/*--${1/(.)/--/g}--*/",
		],
		"description": "小分類コメント"
	},
	"Comment_2": {
		"prefix": "@comm2",
		"body": [
			"/*-------${1/(.)/--/g}-------*/",
			"/*     【${1:コメント}】     */",
			"/*-------${1/(.)/--/g}-------*/",
		],
		"description": "中分類コメント"
	},
	"Comment_3": {
		"prefix": "@comm3",
		"body": [
			"/*------------${1/(.)/--/g}------------*/",
			"/*          【${1:コメント}】          */",
			"/*------------${1/(.)/--/g}------------*/",
		],
		"description": "大分類コメント"
	},
	// TODO: 英語と日本語によって変えるようにする
			// "/*------------${1/([A-Za-z])/-/g}${1/([\\u3040-\\u30FF\\u4E00-\\u9FFF])/--/g}------------*/",
			// "/*          【${1:コメント}】          */",
			// "/*------------${1/([A-Za-z])/-/g}${1/([\\u3040-\\u30FF\\u4E00-\\u9FFF])/--/g}------------*/",
	"Comment_Summary": {
		"prefix": "@commSummary",
		"body": [
			"/// <summary>${1:説明}</summary>",
		],
		"description": "説明コメント"
	},
	"Comment_ParamName": {
		"prefix": "@commParamName",
		"body": [
			"/// <param name=\"${1:変数名}\">${2:説明}</param>",
		],
		"description": "引数説明コメント"
	},
	"Comment_Returns": {
		"prefix": "@commReturns",
		"body": [
			"/// <returns>${1:説明}</returns>",
		],
		"description": "返り値説明コメント"
	},
	"Get_Set": {
		"prefix": "@getSet",
		"body": [
			"/// <summary>${1:説明}取得</summary>",
			"/// <returns>${1: }</returns>",
			"inline ${2:型名} Get${3:関数名}() { return ${4:メンバ変数名}; }",
			"/// <summary>${1: }設定</summary>",
			"/// <param name=\"${5:変数名}\">${6:変数説明}</param>",
			"inline void Set${3: }(${2: } ${5: }) { ${4: } = ${5: }; }",
		],
		"description": "設定取得"
	},
	"TEN_HYPHEN" : {
		"prefix": "@-",
		"body": [
			"----------"
		],
		"description": "ハイフン10個"
	},
}