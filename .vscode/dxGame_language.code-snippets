{
    "Function Template cpp": {
        "prefix": "@func_c",
        "body": [
            "// ${1:コメント}",
			"${2:型} ${2:クラス名}::${3:関数名}(${4:引数})",
			"{",
			"}",
        ],
        "description": "関数テンプレート"
    },
    "Function Template h": {
        "prefix": "@func_h",
        "body": [
            "/*${1:コメント}*/",
			"${2:型} ${3:関数名}(${4:引数})${5:};",
        ],
        "description": "関数テンプレート"
    },
	"Struct Template": {
		"prefix": "@stru",
		"body": [
			"// ${1:コメント}",
			"struct ${2:構造体名}",
			"{",
			"${3}",
			"};"
		],
		"description": "構造体テンプレート"
	},
	"Enum class Template": {
		"prefix": "@enum",
		"body": [
			"// ${1:コメント}",
			"enum class ${2:列挙型名}",
			"{",
			"${3}",
			"};"
		],
		"description": "列挙型テンプレート"
	},
	"Class Template": {
		"prefix": "@class",
		"body": [
			"class ${1:クラス名}",
			"{",
			"private:",
			"public:",
			"    ${1:クラス名}();",
			"    ~${1:クラス名}();",
			"};"
		],
		"description": "クラステンプレート"
	},
	"Derived Class Template": {
		"prefix": "@class_d",
		"body": [
			"class ${1:クラス名} : public ${2:基底クラス名}",
			"{",
			"private:",
			"public:",
			"    ${1:クラス名}();",
			"    ~${1:クラス名}();",
			"};"
		],
		"description": "派生クラステンプレート"
	},
	"Class cpp Template": {
		"prefix": "@class_c",
		"body": [
			"#include \"${1:クラス名}.h\"",
			"",
			"",
			"${1:クラス名}::${1:クラス名}()",
			"{",
			"}",
			"${1:クラス名}::~${1:クラス名}()",
			"{",
			"}"
		],
		"description": "クラステンプレート(CPP)"
	},
	"Comment_1": {
		"prefix": "@comm1",
		"body": [
			"/*----*/",
			"/*【${1:コメント}】*/",
			"/*----*/",
		],
		"description": "小分類コメント"
	},
	"Comment_2": {
		"prefix": "@comm2",
		"body": [
			"/*--------------*/",
			"/*     【${1:コメント}】     */",
			"/*--------------*/",
		],
		"description": "中分類コメント"
	},
	"Comment_3": {
		"prefix": "@comm3",
		"body": [
			"/*------------------------*/",
			"/*          【${1:コメント}】          */",
			"/*------------------------*/",
		],
		"description": "大分類コメント"
	},
}