{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Robot_Battle x64 Debug",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\Robot_Battle.vcxproj",
                "/t:Build",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}